{
  "hosting": {
    "public": "build/web",
    "ignore": ["firebase.json", "**/.*"],
    "cleanUrls": true,
    "rewrites": [{ "source": "**", "destination": "/index.html" }],
    "headers": [
      {
        "source": "**/*.@(js|wasm|otf|ttf|woff2|png|jpg|webp|svg)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
      },
      {
        "source": "/index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/documents/*.pdf",
        "headers": [{ "key": "Content-Disposition", "value": "attachment; filename=\"Muhammed_Faisal_V_Resume.pdf\"" }]
      }
    ]
  }
}
